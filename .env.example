# ==============================================================================
# voxnote Configuration
# Copy this file to `.env` and fill in your settings.
# ==============================================================================

# Google Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# 文字起こし専用モデル (デフォルト: gemini-3.5-transcribe)
# 汎用モデルを使う場合は gemini-3.8-flash 等を指定可能
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# 要約・タイトル生成用モデル (デフォルト: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# 専門用語・固有名詞のカスタム語彙ヒント (カンマ区切り、任意)
# 例: CUSTOM_VOCABULARY=PySide6,pyenv,QApplication,QLabel,LMS
CUSTOM_VOCABULARY=

# USBボイスレコーダーの録音フォルダパス (Mac接続時のマウントパスなど)
# 例: /Volumes/NO NAME/RECORD
RECORDER_SOURCE_DIR=/Volumes/NO NAME/RECORD

# ローカルの音声ファイル取り込み・退避先ディレクトリ
AUDIO_ARCHIVE_DIR=./audio_archive

# 文字起こし・要約結果のMarkdown出力先ディレクトリ
MARKDOWN_OUTPUT_DIR=./output_notes

# 一時チャンク分割・キャッシュ保存ディレクトリ
TMP_CHUNKS_DIR=./.tmp_chunks

# 処理済みファイル履歴の保存パス
HISTORY_FILE_PATH=./processed_files.json

# ボイスレコーダーからローカルへコピー後に元ファイルを削除するか (true / false)
DELETE_SOURCE_FILES=false

# 長時間音声を分割するチャンク秒数 (デフォルト: 600秒 = 10分)
CHUNK_DURATION_SECONDS=600

# 分割時に前後の文脈が途切れないようにするオーバーラップ秒数 (デフォルト: 5秒)
CHUNK_OVERLAP_SECONDS=5

# チャンク分割後に変換する音声フォーマット (m4a / mp3 / wav)
CHUNK_AUDIO_FORMAT=m4a

# macOSデスクトップ通知を有効にするか (true / false)
ENABLE_MACOS_NOTIFICATION=true
